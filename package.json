{
  "name": "zelda-port",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Faithful routine-by-routine JavaScript port of The Legend of Zelda (NES). Requires the user's own ROM; contains no Nintendo assets.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs --open",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "gen-vars": "node scripts/gen-vars.mjs",
    "gen-symbols": "node scripts/gen-symbols.mjs",
    "gen-cfg": "node scripts/gen-cfg.mjs",
    "gen": "node scripts/gen-vars.mjs && node scripts/gen-symbols.mjs && node scripts/gen-cfg.mjs",
    "android:build": "node scripts/android/build.mjs",
    "android:install": "node scripts/android/install.mjs",
    "android:assets": "node scripts/android/copy-web.mjs",
    "android:device-test": "node scripts/android/device-test.mjs"
  }
}
