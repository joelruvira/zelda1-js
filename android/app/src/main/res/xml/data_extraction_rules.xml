<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the saved games go with cloud backups and device transfers; only them (never the ROM). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="save/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="save/" />
    </device-transfer>
</data-extraction-rules>
